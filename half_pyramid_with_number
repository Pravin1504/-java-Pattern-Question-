import java.util.Scanner;
public class half_pyramid_with_number {
    public static void main(String[] args) {


       Scanner sc = new Scanner(System.in);
       System.out.print("Ener a number : ");

       int n = sc.nextInt();


        // outer loop
        for(int i=1; i<=n ; i++){

            // inneer loop
            for(int j = 1; j <= i; j++){
                System.out.print(j+" ");
            }System.out.println();
        }
    }
    
}
